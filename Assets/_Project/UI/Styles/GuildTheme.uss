/*
 * Component styles. Every value here comes from Tokens.uss through var() — if a
 * literal colour or measurement appears below, it is a mistake worth fixing rather
 * than a shortcut.
 *
 * Class names are block__element--modifier. The block is the thing, the element is a
 * part of it, the modifier is a state. It reads verbosely and it means a selector can
 * never accidentally reach into an unrelated part of the tree, which is the failure
 * that makes stylesheets rot.
 *
 * Note the absence of gap: UI Toolkit's flexbox has no gap property, so spacing
 * between siblings is done with margins on the children.
 */

/* ---------------------------------------------------------------- layout ----- */

.guild-root {
    flex-grow: 1;

    /* Transparent, and this is the line where the interface stopped being the game.
       Section 2 of Docs/World_View_Design.md demotes IdleGuild.UI from the screen to the
       chrome around it, and the hall now renders behind this panel -- so a full-screen
       opaque backdrop here is simply a wall in front of it. Nothing else was hiding the
       world: GuildPanelSettings has Clear Color off, so this was the whole of it.

       Every element that needs a surface under it already carries its own
       (--color-surface-raised and friends). This one deliberately does not, which leaves
       --color-surface-base with no consumer for the moment; it is kept in Tokens.uss
       because a genuinely full-screen overlay is the obvious next thing to want it. */
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-text-primary);
    font-size: var(--text-body);
}

.guild-content {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.guild-screen {
    flex-grow: 1;

    /* A full-screen destination is opaque. The root went transparent so the hall could
       show behind the chrome, which left every screen showing floor between its cards --
       correct for a panel, wrong for a menu that is meant to BE the screen. This is also
       what gives --color-surface-base its consumer back after §7 took it away from the
       root. Panels below opt out again. */
    background-color: var(--color-surface-base);
    padding-top: var(--space-md);
    padding-bottom: var(--space-md);
    padding-left: var(--space-md);
    padding-right: var(--space-md);
}

/* A screen that is a panel over the hall rather than the whole screen. The hall
   renders behind the interface now, so a view that flex-grows fills the display with
   chrome and hides the game -- see §7 of Docs/World_View_Design.md. Everything below
   a panel is floor. */
/* The tier card's always-visible row: title on the left, shortfall on the right. */
.card__summary {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.card__detail--collapsed {
    display: none;
}

.guild-screen--panel {
    flex-grow: 0;
    flex-shrink: 0;

    /* Everything below a panel is hall, including the panel's own background. Declared
       after .guild-screen so it wins on order rather than on specificity. */
    background-color: rgba(0, 0, 0, 0);
}

.guild-screen--hidden {
    display: none;
}

.section-title {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    -unity-font-style: bold;
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
}

.section-title--first {
    margin-top: 0;
}

.empty {
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    padding-top: var(--space-sm);
    padding-bottom: var(--space-sm);
}

/* -------------------------------------------------------------- treasury ----- */

.treasury {
    height: var(--height-treasury);
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: var(--space-md);
    padding-right: var(--space-md);
    background-color: var(--color-surface-raised);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.treasury__tier {
    font-size: var(--text-title);
    -unity-font-style: bold;
}

.treasury__tier-note {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
}

.treasury__balances {
    flex-direction: row;
    align-items: center;
}

.currency {
    flex-direction: row;
    align-items: center;
    margin-left: var(--space-lg);
}

.currency__label {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    margin-right: var(--space-xs);
}

.currency__value {
    font-size: var(--text-body);
    -unity-font-style: bold;
}

/* The crown's stipend. Always on screen, disabled while the mailbox is empty —
   an action that is absent and an action that is unavailable must not look the same,
   which is the Day 15 icon rule applied to a button. */
.stipend {
    margin-left: var(--space-lg);
    padding-left: var(--space-md);
    padding-right: var(--space-md);
    height: 34px;
    font-size: var(--text-caption);
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--color-border);
    background-color: var(--color-surface-overlay);
    color: var(--color-text-muted);
}

.stipend:disabled {
    opacity: 0.55;
}

/* Ready to collect: the one moment this control wants to be noticed. */
.stipend--ready {
    border-color: var(--color-gold);
    color: var(--color-gold);
    -unity-font-style: bold;
}

.currency--gold .currency__value { color: var(--color-gold); }
.currency--reputation .currency__value { color: var(--color-reputation); }
.currency--gems .currency__value { color: var(--color-gems); }

/* ------------------------------------------------------------------ tabs ----- */

.tab-bar {
    height: var(--height-tab-bar);
    flex-shrink: 0;
    flex-direction: row;
    background-color: var(--color-surface-raised);
    border-top-width: 1px;
    border-top-color: var(--color-border);
}

.tab {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-top-width: 4px;
    border-top-color: rgba(0, 0, 0, 0);
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    -unity-font-style: bold;
    transition-property: color, border-top-color;
    transition-duration: 0.12s;
}

.tab:hover {
    color: var(--color-text-secondary);
}

.tab--active {
    color: var(--color-accent);
    border-top-color: var(--color-accent);
    background-color: var(--color-surface-overlay);
}

/* ----------------------------------------------------------------- toast ----- */

.toast {
    flex-shrink: 0;
    padding-top: var(--space-sm);
    padding-right: var(--space-md);
    padding-bottom: var(--space-sm);
    padding-left: var(--space-md);
    background-color: var(--color-surface-sunken);
    border-top-width: 1px;
    border-top-color: var(--color-border);
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    white-space: normal;
}

.toast--hidden {
    display: none;
}

.toast--positive { color: var(--color-positive); }
.toast--negative { color: var(--color-negative); }

/* ----------------------------------------------------------------- cards ----- */

.card {
    background-color: var(--color-surface-raised);
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: var(--color-border);
    padding-top: var(--space-md);
    padding-right: var(--space-md);
    padding-bottom: var(--space-md);
    padding-left: var(--space-md);
    margin-bottom: var(--space-sm);
}

.card--interactive {
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.card--interactive:hover {
    background-color: var(--color-surface-overlay);
    border-color: var(--color-border-strong);
}

.card--locked {
    opacity: 0.55;
}

.card__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

/* Icon and title, so the header's space-between still has exactly two ends. */
.card__identity {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
}

.card__title {
    font-size: var(--text-body);
    -unity-font-style: bold;
}

.card__subtitle {
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    margin-top: var(--space-xs);
    white-space: normal;
}

.card__meta {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    margin-top: var(--space-xs);
}

.card__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-sm);
}

/* --------------------------------------------------------------- buttons ----- */

.button {
    margin: 0;
    padding-top: var(--space-sm);
    padding-right: var(--space-md);
    padding-bottom: var(--space-sm);
    padding-left: var(--space-md);
    min-height: 68px;
    border-width: 1px;
    border-color: var(--color-border-strong);
    border-radius: var(--radius-sm);
    background-image: none;
    background-color: var(--color-surface-overlay);
    color: var(--color-text-primary);
    font-size: var(--text-caption);
    -unity-font-style: bold;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.button:hover {
    background-color: var(--color-border);
}

.button:active {
    background-color: var(--color-surface-sunken);
}

.button:disabled {
    background-color: var(--color-disabled);
    border-color: var(--color-disabled);
    color: var(--color-text-muted);
    opacity: 1;
}

.button--primary {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-text-inverse);
}

.button--primary:hover {
    background-color: var(--color-accent-pressed);
}

.button--primary:active {
    background-color: var(--color-accent-pressed);
}

.button--small {
    min-height: 54px;
    padding-top: var(--space-xs);
    padding-right: var(--space-sm);
    padding-bottom: var(--space-xs);
    padding-left: var(--space-sm);
}

.button--wide {
    flex-grow: 1;
}

/* -------------------------------------------------------------- progress ----- */

.progress {
    height: 14px;
    background-color: var(--color-surface-sunken);
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-top: var(--space-sm);
}

.progress__fill {
    height: 100%;
    width: 0%;
    background-color: var(--color-accent);
}

/* ----------------------------------------------------------------- stats ----- */

.stat-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--space-sm);
}

.stat {
    flex-direction: row;
    align-items: center;
    margin-right: var(--space-lg);
    margin-bottom: var(--space-xs);
}

.stat__label {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    margin-right: var(--space-xs);
}

.stat__value {
    font-size: var(--text-caption);
    color: var(--color-text-primary);
    -unity-font-style: bold;
}

.stat__value--met {
    color: var(--color-positive);
}

.stat__value--unmet {
    color: var(--color-negative);
}

/* ---------------------------------------------------------------- badges ----- */

.badge {
    padding-top: 2px;
    padding-right: var(--space-sm);
    padding-bottom: 2px;
    padding-left: var(--space-sm);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-sunken);
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    -unity-font-style: bold;
}

.badge--locked { color: var(--color-negative); }
.badge--active { color: var(--color-positive); }
/* An instruction received and not yet finished — winding down, not broken. */
.badge--pending { color: var(--color-text-muted); }

.rarity--common { color: var(--color-rarity-common); }
.rarity--uncommon { color: var(--color-rarity-uncommon); }
.rarity--rare { color: var(--color-rarity-rare); }
.rarity--epic { color: var(--color-rarity-epic); }
.rarity--legendary { color: var(--color-rarity-legendary); }

/* --------------------------------------------------------------- overlay ----- */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-scrim);
    align-items: center;
    justify-content: center;
    padding-top: var(--space-lg);
    padding-right: var(--space-lg);
    padding-bottom: var(--space-lg);
    padding-left: var(--space-lg);
}

.overlay--hidden {
    display: none;
}

.overlay__panel {
    width: 100%;
    max-width: 900px;
    background-color: var(--color-surface-overlay);
    border-radius: var(--radius-lg);
    border-width: 1px;
    border-color: var(--color-border-strong);
    padding-top: var(--space-lg);
    padding-right: var(--space-lg);
    padding-bottom: var(--space-lg);
    padding-left: var(--space-lg);
}

.overlay__title {
    font-size: var(--text-title);
    -unity-font-style: bold;
}

.overlay__body {
    margin-top: var(--space-md);
    max-height: 900px;
}

.overlay__actions {
    flex-direction: row;
    margin-top: var(--space-lg);
}

.button--spaced {
    margin-left: var(--space-sm);
}

.overlay__panel--tall {
    max-height: 100%;
}

/*
 * The list inside a tall panel is the part that gives. Without this the body keeps
 * its Day 7 fixed ceiling and a sixteen-bed roster pushes the buttons off the phone.
 */
.overlay__body--flexible {
    flex-shrink: 1;
    max-height: none;
}

/* ----------------------------------------------------------------- party ----- */

.party-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-surface-raised);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-md);
    padding-top: var(--space-sm);
    padding-right: var(--space-md);
    padding-bottom: var(--space-sm);
    padding-left: var(--space-md);
    margin-bottom: var(--space-sm);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.party-row:hover {
    border-color: var(--color-border-strong);
}

/*
 * Somebody who cannot join this party is dimmed rather than hidden. A player choosing
 * three of twelve needs to see that the Champion exists and is busy — a list that
 * silently omitted them would read as a roster that had lost someone.
 */
.party-row:disabled {
    opacity: 0.45;
}

.party-row--selected {
    background-color: var(--color-surface-overlay);
    border-color: var(--color-accent);
}

/*
 * The tick is a filled box rather than a glyph, so selection still reads after Week 3
 * swaps in a display font that has never heard of whichever character we picked.
 */
.party-row__mark {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    margin-right: var(--space-md);
    border-width: 2px;
    border-color: var(--color-border-strong);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-sunken);
}

.party-row__mark--checked {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
}

.party-row__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.party-row__name {
    font-size: var(--text-body);
    -unity-font-style: bold;
}

.party-row__meta {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    white-space: normal;
}

/* --------------------------------------------------- destructive actions ----- */

/*
 * Declared after the base button states on purpose: equal specificity resolves by
 * source order in USS, so this has to sit below .button:hover to win. It stays below
 * .button:disabled in specificity, which is what keeps a disabled Retire looking like
 * every other disabled button rather than like a live one.
 */
.button--destructive {
    background-color: var(--color-surface-overlay);
    border-color: var(--color-negative);
    color: var(--color-negative);
}

.button--destructive:hover {
    background-color: var(--color-negative);
    color: var(--color-text-inverse);
}

.button--destructive:active {
    background-color: var(--color-negative);
    color: var(--color-text-inverse);
}

/* ------------------------------------------------------------------ icons ----- */
/*
 * The whole display mechanism for per-content art, in one block. Section 2 of
 * Docs/Day15_Art_Brief.md draws the line: art that varies with CONTENT rides on a
 * Sprite field on the definition asset (this), and art that varies with the SCREEN
 * rides on a USS class (tier backdrops, tab glyphs). Ui.Icon puts the sprite on as a
 * background image precisely so that everything else about it — size, radius, tint,
 * what a missing one looks like — stays here with every other visual decision.
 */

.icon {
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    flex-shrink: 0;
    width: var(--size-icon-md);
    height: var(--size-icon-md);
    margin-right: var(--space-sm);
}

.icon--room {
    width: var(--size-icon-lg);
    height: var(--size-icon-lg);
}

/*
 * Content whose art has not landed is meant to LOOK unfinished. Collapsing the element
 * would be tidier and is the wrong trade: an icon that is absent and an icon that is
 * zero-sized are indistinguishable on screen, and a gap that reads as a finished design
 * is how twenty-three assets ship with one of them missing.
 */
.icon--missing {
    background-color: var(--color-surface-sunken);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-sm);
    opacity: 0.6;
}
